#include <stdio.h>
#include <math.h>

int main() {
    int start = 10, end = 50;
    
    printf("Prime numbers between %d and %d are:\n", start, end);
    
    for (int num = start; num <= end; num++) {
        if (num < 2) continue;
        int isPrime = 1; 
        for (int i = 2; i <= sqrt(num); i++) {
            if (num % i == 0) {
                isPrime = 0; 
                break;
            }
        }
        
        if (isPrime) {
            printf("%d ", num);
        }
    }
    printf("\n");
    return 0;
}