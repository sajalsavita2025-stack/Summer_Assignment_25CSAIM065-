
#include <stdio.h>


int main() {
    int n;
    unsigned long long first = 0, second = 1, next;

    printf("Enter the number: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Please enter a valid positive integer.\n");
        return 1;
    }

    for (int i = 0; i < n-1; i++) {

        if (i < n - 1) {
            printf(", ");
        }
        next = first + second;
        first = second;
        second = next;
    }
    printf("Fibonacci Term: ");
    printf("%d",first);

    printf("\n");
    return 0;
}
