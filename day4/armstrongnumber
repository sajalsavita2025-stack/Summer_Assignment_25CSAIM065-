#include <stdio.h>
#include <math.h>
int main() {
    int n,temp,sum=0,d;
    printf("Enter the number:");
    scanf("%d",&n);
    temp=n;
    d=(int)log10(n)+1;
    while(temp!=0){
        int r=temp%10;
        sum+=pow(r,d);
        temp/=10;
    }
    if(sum==n) printf("Armstrong");
    else printf("Not Armstrong");
    return 0;
}