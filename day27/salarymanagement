#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define FILE_NAME "salary_records.txt"

// Structure to store employee and salary information
typedef struct {
    int id;
    char name[50];
    char designation[30];
    float basic_salary;
    float hra;         // House Rent Allowance
    float da;          // Dearness Allowance
    float tax;         // Tax Deduction
    float net_salary;  // Final Take-home Salary
} Employee;

// Function Prototypes
void addEmployee();
void displayAll();
void searchEmployee();
void calculateSalary(Employee *emp);

int main() {
    int choice;

    while (1) {
        printf("\n=================================");
        printf("\n    SALARY MANAGEMENT SYSTEM     ");
        printf("\n=================================");
        printf("\n1. Add Employee Record");
        printf("\n2. Display All Salary Slips");
        printf("\n3. Search Employee by ID");
        printf("\n4. Exit");
        printf("\nEnter your choice (1-4): ");
        if (scanf("%d", &choice) != 1) {
            printf("Invalid input! Exiting.\n");
            break;
        }

        switch (choice) {
            case 1: addEmployee(); break;
            case 2: displayAll(); break;
            case 3: searchEmployee(); break;
            case 4: printf("\nExiting System. Goodbye!\n"); exit(0);
            default: printf("\nInvalid choice! Please try again.\n");
        }
    }
    return 0;
}

// Function to break down earnings and deductions automatically
void calculateSalary(Employee *emp) {
    emp->hra = emp->basic_salary * 0.20; // 20% HRA
    emp->da = emp->basic_salary * 0.10;  // 10% DA
    emp->tax = emp->basic_salary * 0.05; // 5% Professional Tax
    emp->net_salary = (emp->basic_salary + emp->hra + emp->da) - emp->tax;
}

// Function to add a record to the text file
void addEmployee() {
    FILE *fp = fopen(FILE_NAME, "ab"); // Open in append binary mode
    if (fp == NULL) {
        printf("\nError opening file!");
        return;
    }

    Employee emp;
    printf("\nEnter Employee ID: ");
    scanf("%d", &emp.id);
    getchar(); // Clear trailing newline from buffer

    printf("Enter Name: ");
    fgets(emp.name, sizeof(emp.name), stdin);
    emp.name[strcspn(emp.name, "\n")] = 0; // Strip newline

    printf("Enter Designation: ");
    fgets(emp.designation, sizeof(emp.designation), stdin);
    emp.designation[strcspn(emp.designation, "\n")] = 0;

    printf("Enter Basic Salary: ");
    scanf("%f", &emp.basic_salary);

    // Compute automatic financial fields
    calculateSalary(&emp);

    // Write structure data package to file
    fwrite(&emp, sizeof(Employee), 1, fp);
    fclose(fp);

    printf("\nRecord added successfully!");
}

// Function to view all stored records
void displayAll() {
    FILE *fp = fopen(FILE_NAME, "rb"); // Open in read binary mode
    if (fp == NULL) {
        printf("\nNo records found! Add an employee first.");
        return;
    }

    Employee emp;
    printf("\n==========================================================================================");
    printf("\nID\tName\t\tDesignation\tBasic\t\tHRA\t\tDA\t\tTax\t\tNet Salary");
    printf("\n==========================================================================================");

    while (fread(&emp, sizeof(Employee), 1, fp)) {
        printf("\n%d\t%-12s\t%-12s\t$%-9.2f\t$%-7.2f\t$%-7.2f\t$%-7.2f\t$%-9.2f", 
               emp.id, emp.name, emp.designation, emp.basic_salary, emp.hra, emp.da, emp.tax, emp.net_salary);
    }
    printf("\n==========================================================================================\n");
    fclose(fp);
}

// Function to locate an individual record
void searchEmployee() {
    FILE *fp = fopen(FILE_NAME, "rb");
    if (fp == NULL) {
        printf("\nNo records found!");
        return;
    }

    int searchId, found = 0;
    Employee emp;

    printf("\nEnter Employee ID to search: ");
    scanf("%d", &searchId);

    while (fread(&emp, sizeof(Employee), 1, fp)) {
        if (emp.id == searchId) {
            found = 1;
            printf("\n----- Salary Slip Found -----");
            printf("\nEmployee ID  : %d", emp.id);
            printf("\nName         : %s", emp.name);
            printf("\nDesignation  : %s", emp.designation);
            printf("\nBasic Salary : $%.2f", emp.basic_salary);
            printf("\nHRA (20%%)    : $%.2f", emp.hra);
            printf("\nDA (10%%)     : $%.2f", emp.da);
            printf("\nTax (5%%)     : $%.2f", emp.tax);
            printf("\n-----------------------------");
            printf("\nNet Take-Home: $%.2f", emp.net_salary);
            printf("\n-----------------------------");
            break;
        }
    }

    if (!found) {
        printf("\nEmployee with ID %d not found.", searchId);
    }
    fclose(fp);
}