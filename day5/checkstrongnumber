#include <stdio.h>
int main() {
    int n,temp,sum=0;
    scanf("%d",&n);
    temp=n;
    while(temp!=0){
        int f=1,r=temp%10;
        for(int i=1;i<=r;i++) f*=i;
        sum+=f;
        temp/=10;
    }
    if(sum==n) printf("Strong");
    else printf("Not Strong");
    return 0;
}
